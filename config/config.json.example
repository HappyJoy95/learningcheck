{
  "adb_port": "127.0.0.1:16384",
  "app_package": "com.huawei.iretail.ma",
  "app_activity": "com.huawei.iretail.salesassistant.splash.SplashActivity",
  "account_source": {
    "mode": "mail_then_local",
    "input_dir": "learning_check/input",
    "full_source": "accounts.csv",
    "mail": {
      "enabled": true,
      "server": "imap.qq.com",
      "port": 993,
      "email_env": "LEARNING_CHECK_IMAP_EMAIL",
      "auth_code_env": "LEARNING_CHECK_IMAP_AUTH_CODE",
      "folder": "INBOX",
      "attachment_name": "accounts.csv",
      "max_scan": 50
    }
  },
  "automation": {
    "batch_size": 30,
    "ocr_timeout_seconds": 300,
    "ocr_enabled": true,
    "ocr_workers": 2
  },
  "notify_enabled": true,
  "notify_type": [
    "email"
  ],
  "notify_email_target": "your_email@example.com",
  "upload": {
    "enabled": true,
    "mcp_host": "your_mcp_host",
    "mcp_port": 8082,
    "owner_key": "your_owner_key",
    "remote_path": "learning_check"
  }
}
